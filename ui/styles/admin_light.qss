/* Admin console: a light, airy theme. Set on the AdminScreen widget only, so the visitor screen
   (theme.qss, dark kiosk) is untouched; a widget's own sheet wins over the application's.
   Never set font-family here (see ui/fonts.py): readability comes from size, weight, spacing.
   url(@styles/...) is replaced with this folder's path when the sheet is loaded.

   Palette
     page   #eef3f8   surface #ffffff   section #f5f9fc   line #d5e0ea   line-strong #b4c4d3
     text   #16293b   secondary #44596c   muted #5b6f82
     accent #0a7f92 (text on white 5:1)   accent-soft #dff3f6   accent-hover #086b7b
     green  #11805a / #e3f6ee    amber #9a5b00 / #fff3da    red #c22f41 / #fdebed    blue #2459b5 / #e6efff */

QWidget { font-size: 18px; color: #16293b; }
QDialog, QMessageBox { background: #ffffff; }
QToolTip {
    color: #16293b; background: #ffffff; border: 1px solid #b4c4d3;
    border-radius: 6px; padding: 6px 8px; font-size: 15px;
}

#adminScreen { background: #eef3f8; }
QStackedWidget, QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }

/* --- panels --- */
QFrame[role="panel"], QFrame[role="sidebar"] {
    background: #ffffff; border: 1px solid #d5e0ea; border-radius: 16px;
}
QFrame[role="section"] {
    background: #f5f9fc; border: 1px solid #dbe5ee; border-radius: 14px;
}
QFrame[role="card"] { background: #ffffff; border: 1px solid #d5e0ea; border-radius: 14px; padding: 8px; }
QFrame[role="divider"] { background: #dbe5ee; border: none; max-height: 1px; min-height: 1px; }

/* status cards: a white surface with a coloured edge that says how the part is doing */
QFrame[role="metric"], QFrame[role="tile"] {
    background: #ffffff; border: 1px solid #d5e0ea; border-left: 5px solid #b4c4d3; border-radius: 12px;
}
QFrame[role="metric"][level="safe"] { border-left-color: #1fa774; }
QFrame[role="metric"][level="wait"] { border-left-color: #e29a1d; }
QFrame[role="metric"][level="danger"] { border-left-color: #d9475a; }
QFrame[role="metric"][level="info"] { border-left-color: #4f86d6; }

/* --- text --- */
QLabel { background: transparent; }
QLabel[role="heading"] { font-size: 20px; font-weight: bold; color: #0f2234; }
QLabel[role="title"] { font-size: 22px; font-weight: bold; color: #0f2234; }
QLabel[role="page-title"] { font-size: 26px; font-weight: bold; color: #0f2234; }
QLabel[role="section-title"] { font-size: 20px; font-weight: bold; color: #0f2234; padding: 4px 0 2px 0; }
QLabel[role="hint"] { font-size: 16px; color: #4a5f72; }
QLabel[role="hint"][level="error"] { color: #c22f41; }
QLabel[role="error"] { font-size: 16px; color: #c22f41; }
QLabel[role="eyebrow"] { font-size: 14px; font-weight: bold; color: #0a7f92; }
QLabel[role="clock"] { font-size: 17px; color: #44596c; padding: 0 6px; }
QLabel[role="field-label"] { font-size: 17px; color: #2c4257; }
QLabel[role="field-title"] { font-size: 17px; color: #16293b; }
QLabel[role="card-title"] { font-size: 16px; font-weight: bold; color: #44596c; }
QLabel[role="card-note"] { font-size: 16px; color: #44596c; }
QLabel[role="tile-value"], QLabel[role="metric-value"] { font-size: 26px; font-weight: bold; color: #0f2234; }
QLabel[role="metric-value"][level="safe"] { color: #11805a; }
QLabel[role="metric-value"][level="wait"] { color: #9a5b00; }
QLabel[role="metric-value"][level="danger"] { color: #c22f41; }
QLabel[role="metric-value"][level="info"] { color: #2459b5; }
QLabel[role="slider-value"] { font-size: 17px; font-weight: bold; color: #0a7f92; }
QLabel[role="list-text"] { font-size: 18px; color: #16293b; }
QLabel[role="venue-now"] { font-size: 18px; font-weight: bold; color: #08788a; }

QLabel[role="message"] { font-size: 16px; min-height: 24px; }
QLabel[role="message"][level="info"] { color: #08788a; }
QLabel[role="message"][level="error"] { color: #c22f41; font-weight: bold; }

QLabel[role="badge"] {
    background: #dff3f6; border: 1px solid #9bd3dc; border-radius: 12px;
    color: #08788a; font-size: 18px; font-weight: bold;
}
QLabel[role="rank"] {
    font-size: 15px; font-weight: bold; color: #08788a;
    background: #dff3f6; border: 1px solid #9bd3dc; border-radius: 8px; min-height: 28px;
}
QLabel[role="count"] {
    font-size: 14px; font-weight: bold; color: #44596c;
    background: #e8eff5; border-radius: 10px; padding: 3px 10px;
}
QLabel[role="dot"] { border-radius: 5px; background: #0a7f92; min-height: 10px; max-height: 10px; }
QLabel[role="dot"][level="wait"] { background: #e29a1d; }
QLabel[role="dot"][level="danger"] { background: #d9475a; }

/* status pill (header and pages) */
QLabel[role="tag"] {
    font-size: 16px; font-weight: bold; padding: 6px 14px; border-radius: 16px;
    border: 1px solid #9bd3dc; background: #e8f6f9; color: #08788a;
}
QLabel[role="tag"][level="safe"] { color: #11805a; background: #e3f6ee; border-color: #93d8b9; }
QLabel[role="tag"][level="wait"] { color: #9a5b00; background: #fff3da; border-color: #efc778; }
QLabel[role="tag"][level="danger"] { color: #c22f41; background: #fdebed; border-color: #eba3ac; }

/* something the Admin must keep in mind on this page */
QLabel[role="notice"] {
    font-size: 16px; color: #7a4a00; padding: 10px 14px; border-radius: 10px;
    background: #fff3da; border: 1px solid #efc778;
}

/* event categories (dashboard alerts, Log filters) */
QLabel[role="category"] {
    font-size: 13px; font-weight: bold; padding: 3px 10px; border-radius: 10px;
    background: #e8eff5; color: #44596c;
}
QLabel[role="category"][category="error"] { background: #fdebed; color: #c22f41; }
QLabel[role="category"][category="warning"] { background: #fff3da; color: #9a5b00; }
QLabel[role="category"][category="safety"] { background: #ffeadb; color: #b4500f; }
QLabel[role="category"][category="connection"] { background: #e6efff; color: #2459b5; }
QLabel[role="category"][category="command"] { background: #dff3f6; color: #08788a; }

/* --- buttons --- */
QPushButton {
    min-height: 46px; padding: 4px 20px; border-radius: 10px;
    border: 1px solid #b4c4d3; background: #ffffff; color: #16293b;
    font-size: 17px; font-weight: bold;
}
QPushButton:hover { background: #eef5fa; border-color: #8fa6ba; }
QPushButton:pressed { background: #dfeaf2; }
QPushButton:disabled { color: #8a9bab; background: #f1f5f9; border-color: #dbe5ee; }
QPushButton[role="primary"] { background: #0a7f92; border-color: #0a7f92; color: #ffffff; }
QPushButton[role="primary"]:hover { background: #086b7b; border-color: #086b7b; }
QPushButton[role="primary"]:pressed { background: #065a68; }
QPushButton[role="danger"] { background: #fdebed; border-color: #e3939d; color: #a82637; }
QPushButton[role="danger"]:hover { background: #fadadd; }
QPushButton[role="danger"]:pressed { background: #f5c6cb; }
QPushButton[role="ghost"] {
    min-height: 36px; font-size: 15px; font-weight: normal; color: #44596c;
    border: 1px solid #b4c4d3; background: transparent;
}
QPushButton[role="primary"]:disabled, QPushButton[role="danger"]:disabled {
    color: #8a9bab; background: #f1f5f9; border-color: #dbe5ee;
}
QPushButton[role="logout"] { min-height: 42px; font-size: 16px; }
QPushButton[role="filter-chip"] {
    min-height: 36px; padding: 2px 16px; font-size: 15px; font-weight: normal; border-radius: 18px;
    color: #2c4257; background: #ffffff; border: 1px solid #b4c4d3;
}
QPushButton[role="filter-chip"]:hover { background: #eef5fa; }
QPushButton[role="filter-chip"]:checked { color: #ffffff; background: #0a7f92; border-color: #0a7f92; font-weight: bold; }

/* sidebar navigation */
QFrame[role="sidebar"] QScrollBar:vertical { width: 8px; margin: 6px 2px; }
QFrame[role="sidebar"] QScrollBar::handle:vertical { background: #c5d3df; border-radius: 3px; }
QPushButton[role="side-nav"] {
    text-align: left; min-height: 40px; padding: 0 14px;
    font-size: 18px; font-weight: normal; color: #2c4257;
    background: transparent; border: none; border-left: 4px solid transparent; border-radius: 10px;
}
QPushButton[role="side-nav"]:hover { background: #eef5fa; color: #0f2234; }
QPushButton[role="side-nav"]:checked {
    background: #dff3f6; color: #064b58; font-weight: bold; border-left: 4px solid #0a7f92;
}

/* segmented switch between the sub-pages of a merged page */
QFrame[role="segments"] { background: #e8eff5; border: none; border-radius: 12px; }
QPushButton[role="segment"] {
    min-height: 40px; min-width: 120px; padding: 2px 26px; font-size: 17px; font-weight: bold; color: #5b6f82;
    background: transparent; border: none; border-radius: 10px;
}
QPushButton[role="segment"]:hover { color: #0f2234; background: #dbe6ef; }
QPushButton[role="segment"]:checked {
    background: #ffffff; color: #064b58; border: 1px solid #c5d3df;
}

/* --- inputs --- */
QLineEdit, QSpinBox, QComboBox {
    min-height: 46px; padding: 2px 12px; border-radius: 9px;
    border: 1px solid #b4c4d3; background: #ffffff; color: #16293b;
    selection-background-color: #bfe6ec; selection-color: #0f2234;
}
QLineEdit:focus, QSpinBox:focus, QPlainTextEdit:focus, QComboBox:focus { border: 2px solid #0a7f92; }
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled { background: #f1f5f9; color: #8a9bab; }
QSpinBox::up-button, QSpinBox::down-button { width: 30px; border: none; background: transparent; }
QSpinBox::up-arrow { image: url(@styles/chevron-up-dark.png); width: 14px; height: 14px; }
QSpinBox::down-arrow { image: url(@styles/chevron-down-dark.png); width: 14px; height: 14px; }
QComboBox::drop-down { border: none; width: 36px; }
QComboBox::down-arrow { image: url(@styles/chevron-down-dark.png); width: 16px; height: 16px; }
QComboBox QAbstractItemView {
    background: #ffffff; color: #16293b; border: 1px solid #b4c4d3; outline: none; padding: 4px;
    selection-background-color: #dff3f6; selection-color: #064b58;
}
QPlainTextEdit, QTextEdit {
    border-radius: 10px; border: 1px solid #b4c4d3; background: #ffffff; color: #16293b;
    padding: 8px; selection-background-color: #bfe6ec; selection-color: #0f2234;
}
QPlainTextEdit[role="log"] { font-size: 15px; background: #f7fafc; color: #22384c; border: 1px solid #d5e0ea; }

QCheckBox { spacing: 12px; min-height: 40px; }
QCheckBox::indicator { width: 24px; height: 24px; border-radius: 6px; border: 2px solid #8fa6ba; background: #ffffff; }
QCheckBox::indicator:hover { border-color: #0a7f92; }
QCheckBox::indicator:checked { background: #0a7f92; border-color: #0a7f92; image: url(@styles/check.png); }

QSlider { min-height: 34px; }
QSlider::groove:horizontal { height: 6px; border-radius: 3px; background: #d5e0ea; }
QSlider::sub-page:horizontal { border-radius: 3px; background: #0a7f92; }
QSlider::handle:horizontal {
    width: 18px; height: 18px; margin: -9px 0; border-radius: 12px;
    background: #ffffff; border: 3px solid #0a7f92;
}
QSlider::handle:horizontal:pressed { background: #0a7f92; }

QProgressBar { border: none; border-radius: 5px; background: #dbe5ee; min-height: 10px; }
QProgressBar::chunk { border-radius: 5px; background: #0a7f92; }

/* --- tables: roomy rows, soft stripes, nothing squeezed --- */
QTableWidget {
    border: 1px solid #d5e0ea; border-radius: 10px; background: #ffffff;
    alternate-background-color: #f6f9fc; gridline-color: #e6edf3;
    font-size: 17px; color: #16293b;
    selection-background-color: #d7f0f4; selection-color: #064b58;
}
QTableWidget::item { padding: 6px 10px; border: none; }
QTableCornerButton::section { background: #eaf1f7; border: none; }
QHeaderView { background: transparent; }
QHeaderView::section {
    font-size: 16px; font-weight: bold; padding: 10px 10px;
    color: #2c4257; background: #eaf1f7; border: none; border-bottom: 1px solid #c5d3df;
}

/* --- scrollbars --- */
QScrollBar:vertical { width: 12px; margin: 3px; border: none; background: transparent; }
QScrollBar::handle:vertical { min-height: 48px; background: #b9c9d7; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #8fa6ba; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { height: 12px; margin: 3px; border: none; background: transparent; }
QScrollBar::handle:horizontal { min-width: 48px; background: #b9c9d7; border-radius: 4px; }
QScrollBar::handle:horizontal:hover { background: #8fa6ba; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* --- tabs (if any page still uses QTabWidget) --- */
QTabWidget::pane { border: 1px solid #d5e0ea; border-radius: 12px; background: #ffffff; }
QTabBar::tab {
    min-height: 44px; padding: 2px 16px; font-size: 17px; color: #44596c;
    border: none; border-bottom: 3px solid transparent; background: transparent;
}
QTabBar::tab:selected { font-weight: bold; color: #08788a; border-bottom-color: #0a7f92; }

QMenu { background: #ffffff; border: 1px solid #b4c4d3; padding: 4px; }
QMenu::item { padding: 8px 20px; border-radius: 6px; }
QMenu::item:selected { background: #dff3f6; color: #064b58; }
