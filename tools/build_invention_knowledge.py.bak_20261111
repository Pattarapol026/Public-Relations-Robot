ENTRIES += stats_entries()  # the report of 10 Nov 2026: inventions by region and province
ENTRIES += event_entries()  # the event's pictures of 10 Nov 2026: schedule, map, building 9, registration, group 5


def _deduplicated(entries: list) -> list:
    """One entry per question: a later one (from the pictures) replaces an older answer to the same question."""
    from services.knowledge_transfer import question_key

    latest = {question_key(entry[1]): entry for entry in entries}
    seen, result = set(), []
    for entry in entries:
        key = question_key(entry[1])
        if key not in seen:
            seen.add(key)
            result.append(latest[key])
    return result


ENTRIES[:] = _deduplicated(ENTRIES)


def main() -> None:
    with OUT.open("w", encoding="utf-8-sig", newline="") as file:
        writer = csv.writer(file)
        writer.writerow(COLUMNS)
        for category, question, answer, keywords, shortcut, question_en, answer_en in ENTRIES:
            writer.writerow([category, question, answer, keywords, "ใช่" if shortcut else "ไม่", "ไม่" if question in DISABLED_QUESTIONS else "ใช่", "", VENUE,
                             question_en, answer_en])
    print(f"{len(ENTRIES)} entries -> {OUT}")


if __name__ == "__main__":
    main()
