# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า — ห้าม commit ไฟล์ .env

# --- AI: Gemini ---
# เว้นว่างได้: โปรแกรมจะทำงานใน Demo Mode (ตอบจากฐานความรู้อย่างเดียว)
GEMINI_API_KEY=
# false = ไม่เรียก Gemini แม้มี key (ตอบจากฐานความรู้อย่างเดียว ไม่ส่งคำถามออกอินเทอร์เน็ต)
AI_ENABLED=true
# รุ่น lite ตอบภาษาไทยได้ครบในราว 1 วินาที รุ่นที่ "คิด" ก่อนตอบ (เช่น 3.8-flash) ช้ากว่ามาก
GEMINI_MODEL=gemini-3.5-flash-lite
# รอคำตอบนานสุดกี่วินาที (รวมการลองใหม่) ก่อนตอบจากฐานความรู้แทน
GEMINI_TIMEOUT_S=4.5
# true: a question a knowledge-base entry clearly answers is answered from it at once, without the AI
AI_KNOWLEDGE_FIRST=true

# --- เสียงพูด: PyThaiTTS ---
# false = แสดงคำตอบเป็นข้อความอย่างเดียว
# ครั้งแรกจะดาวน์โหลดโมเดลราว 330 MB ไปที่ ~/.cache/fastthaig2p
TTS_ENABLED=true
# ความเร็วในการพูด (อัตราเร็ว: 1.0 = ความเร็วเดิมของเสียง ค่าน้อยพูดช้าลง 0.9 ใช้เวลานานขึ้นราว 9%)
TTS_SPEED=0.90

# --- หุ่นยนต์ ---
# รุ่นนี้รองรับเฉพาะ mock (หุ่นยนต์จำลอง) การเชื่อมหุ่นยนต์จริงจะมาใน V0.8
ROBOT_ADAPTER=mock
ROBOT_COMMAND_TIMEOUT_S=30
# true = สั่งหุ่นยนต์ด้วยคำพูดหรือข้อความได้ (เช่น "หันซ้าย", "หยุด")
# false = สั่งได้จากปุ่มบนจอเท่านั้น
ROBOT_VOICE_COMMANDS=true
# หุ่นยนต์ไม่ขยับถ้ากล้องเห็นคนอยู่ใกล้กว่าระยะนี้ (เมตร)
# ตั้งให้มากกว่าระยะที่ตัวหุ่นยนต์กวาดไปตอนหันตัวจริง (หุ่นยนต์ยังไม่มีแขน)
ROBOT_BASE_CLEARANCE_M=0.6

LOG_LEVEL=INFO
UI_FULLSCREEN=false
# วินาทีที่ไม่มีการสัมผัสจอก่อนกลับหน้าต้อนรับ (หน้าจอผู้ใช้)
IDLE_TIMEOUT_S=90
# วินาทีที่ไม่มีการใช้งานก่อนออกจากโหมด Admin เอง 0 = ไม่ออกเอง อยู่จนกว่าจะกดออก
ADMIN_IDLE_TIMEOUT_S=0

# --- เสียง: ไมโครโฟนและการถอดเสียง (faster-whisper) ---
# false = ปิดไมโครโฟน ใช้การพิมพ์และปุ่มลัดอย่างเดียว
STT_ENABLED=true
# tiny / base / small / medium / large-v3 / large-v3-turbo — ใหญ่ขึ้นแม่นขึ้นแต่ช้าลง
# ครั้งแรกจะดาวน์โหลดโมเดลจากอินเทอร์เน็ตมาเก็บใน MODEL_DIR (small ≈ 500 MB)
STT_MODEL=small
# cpu / cuda / auto — cuda = ถอดเสียงบนการ์ดจอ NVIDIA (โมเดลไทย medium ใช้ 0.5-1 วินาที เทียบกับ 5.4 วินาทีบน CPU)
# ต้องมีการ์ดจอ NVIDIA และ pip install nvidia-cublas-cu12 nvidia-cudnn-cu12 ; ถ้าใช้ไม่ได้โปรแกรมกลับไปใช้ CPU เองและบันทึกไว้ใน log
STT_DEVICE=cuda
# float16 เหมาะกับ cuda ; int8 เหมาะกับ CPU (ถ้าตั้ง float16 แล้วต้องใช้ CPU โปรแกรมเปลี่ยนเป็น int8 ให้)
STT_COMPUTE_TYPE=float16
# th = ถอดเป็นภาษาไทยเสมอ (แนะนำ: คำอังกฤษที่ปนในประโยคไทยยังถอดได้ แต่ประโยคอังกฤษล้วนจะถอดผิด)
# auto = ให้โมเดลเดาภาษาเองทุกครั้ง (รองรับผู้พูดอังกฤษ แต่ประโยคไทยสั้น ๆ อาจถูกเดาภาษาผิด)
STT_LANGUAGE=th
# ภาษาไทยใช้โมเดลที่ฝึกมาเพื่อภาษาไทย (Thonburian Whisper medium ≈ 1.5 GB ใน MODEL_DIR)
# ถอดไทยแม่นกว่า small มาก แต่ช้ากว่า (ราว 5 วินาทีต่อคำถามบน CPU) ภาษาอังกฤษยังใช้ STT_MODEL เหมือนเดิม
# ว่าง = โมเดลเริ่มต้น · none = ปิด ใช้ STT_MODEL กับภาษาไทยด้วย (แบบเดิม)
STT_THAI_MODEL=
# โมเดลเล็กที่ใช้ตัดสินว่าพูดไทยหรืออังกฤษก่อนถอด (tiny ≈ 75 MB เร็ว)
STT_DETECTOR_MODEL=tiny
MODEL_DIR=models
# ระดับเสียง (0–1) ที่นับว่าเป็นเสียงพูด — เพิ่มค่าถ้าสถานที่เสียงดัง
MIC_LEVEL_THRESHOLD=0.02
# เงียบนานเท่านี้หลังพูด ถือว่าพูดจบ
MIC_SILENCE_SECONDS=1.0
MIC_NO_SPEECH_TIMEOUT_S=6
MIC_MAX_SECONDS=20
# true = ป้าย "ไมโครโฟน" บนหน้าจอขึ้น "พร้อม" เฉพาะเมื่อเสียบไมโครโฟนอาเรย์ ReSpeaker XVF3800 อยู่ (ไม่เสียบ = ไม่พร้อม)
# false = ดูแค่ว่าไมโครโฟนที่เลือกใช้งานได้ (ใช้กับไมค์ในเครื่อง)
MIC_ARRAY_REQUIRED=true
# true = ตอบเสร็จแล้วเปิดไมโครโฟนรอคำถามถัดไปเอง (ถ้าไม่มีใครพูดต่อจะหยุดฟังเงียบ ๆ)
VOICE_FOLLOW_UP=true

# --- กล้อง OAK-D: ตรวจจับคนและระยะ เพื่อทักทายก่อนและรู้ว่าผู้ใช้เดินจากไปแล้ว ---
# false = ไม่ใช้กล้อง โปรแกรมทำงานแบบเดิม (ไม่มีกล้องเสียบอยู่ก็เปิดโปรแกรมได้)
VISION_ENABLED=true
# ครั้งแรกจะดาวน์โหลดโมเดลตรวจจับมาเก็บใน MODEL_DIR/depthai
VISION_MODEL=yolov6-nano
VISION_FPS=10
# Smart Welcome ใช้ระยะสามวงรอบหุ่นยนต์ (เมตร) เรียงจากใกล้ไปไกล:
# 1) ระยะสนทนา: เข้ามาใกล้กว่านี้นาน VISION_DWELL_SECONDS → เปิดไมโครโฟนรับเสียง
VISION_ENGAGE_DISTANCE_M=1.5
VISION_DWELL_SECONDS=0.8
# 2) บริเวณให้บริการ: อยู่ใกล้กว่านี้นาน VISION_GREET_DWELL_SECONDS → ทักทายและเปิดหน้าเมนูบริการ
#    (เวลานานพอที่คนเดินผ่านเฉย ๆ จะไม่ถูกทัก)
VISION_GREET_DISTANCE_M=3.0
VISION_GREET_DWELL_SECONDS=1.5
# 3) ห่างเกินระยะนี้หรือไม่เห็นนาน VISION_LEAVE_SECONDS → ถือว่าเดินจากไป ล้างการสนทนา
VISION_RELEASE_DISTANCE_M=3.6
VISION_LEAVE_SECONDS=4
# คนที่ออกจากกล้องแล้วกลับเข้ามาใหม่ จะถูกทักก็ต่อเมื่อหายไปนานเกินกี่วินาที (ไม่นานกว่านี้ถือว่าเป็นคนเดิม) และต้องเห็นทั้งตัว ไม่ใช่แค่มือ
VISION_GREET_COOLDOWN_SECONDS=90
# ความกว้างด้านข้างของจุดสนทนา (บริเวณให้บริการกว้างกว่านี้ 1.5 เท่า)
VISION_LATERAL_LIMIT_M=1.0
# true = เข้ามาถึงระยะสนทนาแล้วเปิดไมโครโฟนฟังเองโดยไม่ต้องกดปุ่ม
VISION_AUTO_LISTEN=true
# true = แสดงภาพสดจากกล้องบนหน้าแรกและหน้าสนทนา (แสดงอย่างเดียว ไม่บันทึก)
# false = กล้องส่งเฉพาะตำแหน่งคน ไม่มีภาพออกจากตัวกล้องเลย
VISION_PREVIEW=true
VISION_PREVIEW_FPS=20
# true = ให้กล้องจำการ์ดสัญลักษณ์และท่าทางมือ (ตั้งค่าการตอบสนองที่ Admin → การ์ด/ท่าทาง)
VISION_SIGNS=true
# false = จำเฉพาะการ์ด ไม่จำท่าทางมือ (ครั้งแรกที่เปิดท่าทางจะดาวน์โหลดโมเดลราว 8 MB)
VISION_GESTURES=true

# --- สถิติการใช้งาน ---
# true = เก็บข้อความคำถามและคำตอบไว้ในเครื่อง เพื่อให้ Admin เห็นคำถามที่หุ่นยนต์ตอบไม่ได้
# false = เก็บเฉพาะตัวเลข (จำนวนคำถาม ที่มาของคำตอบ คำติชม) ไม่เก็บข้อความ
LOG_QUESTIONS=true
# ลบข้อมูลการใช้งานที่เก่ากว่ากี่วันโดยอัตโนมัติ
USAGE_RETENTION_DAYS=90

# ขนาดไฟล์สื่อสูงสุดที่ Admin อัปโหลดได้ (MB)
MEDIA_MAX_VIDEO_MB=500
MEDIA_MAX_IMAGE_MB=20

# ตำแหน่งเก็บข้อมูล (relative = อิงโฟลเดอร์โปรเจกต์)
DATA_DIR=data
LOG_DIR=logs
MEDIA_DIR=media

# --- MQTT (ทดสอบการสื่อสารกับอุปกรณ์ฮาร์ดแวร์เท่านั้น ไม่ได้สั่งงานหุ่นยนต์) ---
# false = ไม่เชื่อมต่อ MQTT เลย (ค่าเริ่มต้น)
MQTT_ENABLED=false
# broker ทดสอบในเครื่อง: .venv313\Scripts\python.exe tools\mqtt_broker.py (ฟังเฉพาะ 127.0.0.1)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=prrobot-app
# ชื่อผู้ใช้/รหัสผ่านของ broker (ถ้ามี) ใส่ใน .env เท่านั้น ห้ามใส่ในซอร์สโค้ด
MQTT_USERNAME=
MQTT_PASSWORD=
# true = เข้ารหัสด้วย TLS (มักใช้พอร์ต 8883) ใส่ไฟล์ CA ถ้า broker ใช้ใบรับรองของตัวเอง
MQTT_TLS=false
MQTT_CA_FILE=
# topic ทั้งหมดอยู่ใต้ prefix นี้: <prefix>/command, /response, /telemetry, /status
MQTT_TOPIC_PREFIX=prrobot/test
# รอคำตอบจากอุปกรณ์นานสุดกี่วินาที
MQTT_RESPONSE_TIMEOUT_S=3

# --- MQTT ไปยังฮาร์ดแวร์จริง (หน้า Admin → สั่งทิศทาง (MQTT)) ---
# หุ่นยนต์จริงอาจขยับเมื่อกดปุ่มในหน้านั้น เว้นว่าง = ปิด (ค่าเริ่มต้น)
MQTT_HW_HOST=
MQTT_HW_PORT=1883
MQTT_HW_USERNAME=
MQTT_HW_PASSWORD=
# topic ที่คำสั่งหยุดไปเสมอ
MQTT_HW_DIRECTION_TOPIC=robot/direction
# topic เริ่มต้นของการหัน (left/right องศา) และการเดิน (forward/backward ซม.) ว่าง = ใช้ MQTT_HW_DIRECTION_TOPIC
MQTT_HW_TURN_TOPIC=
MQTT_HW_MOVE_TOPIC=
# topic ให้เลือกในหน้าควบคุมหุ่นยนต์ (คั่นด้วย ,) พิมพ์เพิ่มในหน้านั้นได้
MQTT_HW_TOPICS=robot/direction,robot/status,robot/mode
# ข้อความหยุดที่ฮาร์ดแวร์เข้าใจ (ถามทีมฮาร์ดแวร์) ถ้าว่าง ปุ่มซ้าย/ขวาจะกดไม่ได้
MQTT_HW_STOP_PAYLOAD=
# แขนของหุ่นยนต์: topic และข้อความ "โบกมือ" / "กลับท่าเดิม" (ค่าเหล่านี้เป็นค่าเดา ถามทีมฮาร์ดแวร์ให้ตรงกัน)
# แก้ได้ที่หน้า ควบคุมหุ่นยนต์ → แขน ด้วย
MQTT_HW_ARM_TOPIC=robot/arm
MQTT_HW_ARM_WAVE_PAYLOAD=wave
MQTT_HW_ARM_HOME_PAYLOAD=home
# topic ที่ฮาร์ดแวร์ตอบกลับ (ถ้ามี) ต้องไม่ใช่ topic เดียวกับด้านบน ลงท้าย # ได้ เช่น robot/r1/#
MQTT_HW_REPLY_TOPIC=
# topic ที่หุ่นยนต์บอกสถานะตัวเอง (แสดงในหน้าสั่งทิศทาง ต้องไม่ใช่ topic ที่เราส่งออกไป)
MQTT_HW_STATUS_TOPIC=robot/r1/status
# รูปแบบข้อความ ต้องมี {direction} (left/right) และ {value}
MQTT_HW_PAYLOAD_FORMAT={direction} {value}
# มุมหันสูงสุด (องศา, 1–360) และระยะเดินสูงสุด (ซม., 1–1000) ค่าต่ำสุดคือ 1
MQTT_HW_TURN_MAX_DEG=180
MQTT_HW_MOVE_MAX_CM=100
# true = กล้อง OAK-D ต้องไม่เห็นคนใกล้กว่า ROBOT_BASE_CLEARANCE_M ก่อนส่ง (ต้องเสียบกล้อง)
MQTT_HW_REQUIRE_CAMERA=false

# --- ทิศทางเสียง (DOA) และการจับคู่ผู้พูดกับคนที่กล้องเห็น (ไม่สั่งหุ่นยนต์หมุนหรือเคลื่อนที่) ---
# none = ไม่มีไมค์ที่วัดทิศทางได้ (ค่าเริ่มต้น ไมค์ในโน้ตบุ๊กไม่ถือว่ารองรับ)
# xvf3800 = ReSpeaker XVF3800: อ่านทิศผ่าน USB (ต้อง pip install pyusb libusb-package; ไม่ต้องลงไดรเวอร์)
#            แล้วไปปรับเทียบที่ Admin > อุปกรณ์ > เสียง > ทิศทางเสียง  ก่อนเปิดใช้โหมดล็อกทิศ
AUDIO_DIRECTION_SOURCE=none
# ตำแหน่งไมค์เทียบกับกล้อง OAK-D (เมตร): X = ไปทางขวาของกล้อง, Z = ไปข้างหน้ากล้อง
MIC_OFFSET_X_M=0
MIC_OFFSET_Z_M=0
# ไมค์หันไปทางขวาของแกนหน้ากล้องกี่องศา (ซ้าย = ค่าลบ)
MIC_YAW_DEG=0
# มุมมองแนวนอนของกล้อง (องศา) เสียงจากนอกมุมนี้จะไม่ถูกจับคู่กับใคร
CAMERA_HFOV_DEG=69
# คนที่อยู่ห่างจากทิศเสียงไม่เกินกี่องศาจึงอาจเป็นผู้พูด
SPEAKER_MATCH_TOLERANCE_DEG=15

# 0 = ทักทายทุกคนที่เข้ามาในระยะกล้อง (ครั้งเดียวต่อการมาหนึ่งครั้ง) ; ใส่เป็นวินาที เช่น 1.5 = ทักเฉพาะคนที่ยืนนิ่งนานเท่านั้น
VISION_GREET_STILL_SECONDS=0

# Listen to ONE voice: the visitor who started the turn. Other people talking nearby are not answered
# and their words are silenced before transcription. Needs a 26 MB speaker model (fetched once into MODEL_DIR).
# MIC_SPEAKER_LOCK=true

# ฟังเฉพาะคนที่อยู่หน้ากล้อง: ตอนที่กล้องทำงานแต่ไม่เห็นใครเลย เสียงที่เข้ามาถูกมองว่ามาจากที่อื่นและไม่ตอบ
# VOICE_VISITOR_ONLY=true
# ดูการขยับปากด้วย: ถ้าเห็นหน้าชัดและมีเสียงพูดเกิน 1.3 วินาที แต่ปากไม่ขยับเลย ถือว่าไม่ใช่เสียงของคนที่คุยกับหุ่นยนต์
# (ไม่เห็นหน้า หรือหน้าหันหนี = บอกไม่ได้ จึงฟังตามปกติ) กด "เริ่มสนทนา" จะข้ามการตรวจนี้ ปิดได้ในหน้า Admin
# VOICE_LIP_CHECK=true
# ความไวในการจับการขยับปาก (ค่าน้อย = ไวขึ้น)
# VOICE_LIP_THRESHOLD=0.10
# ให้กล้องอ่านการขยับปาก (ใช้ MediaPipe Face Landmarker ในโปรเซสของกล้อง)
# VISION_MOUTH=true
